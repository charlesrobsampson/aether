{
  "server": {
    "port": 8080,
    "db_path": "./data/aether.db"
  },
  "persona": {
    "name": "Aether",
    "prefixes": ["!", "/", "Aether "]
  },
  "auth": {
    "jwt_secret": "dev-only-change-me"
  },
  "limits": {
    "rate_per_second": 1,
    "burst": 5,
    "queue_depth": 256,
    "dispatch_queue_depth": 256,
    "dedupe_ttl_seconds": 900
