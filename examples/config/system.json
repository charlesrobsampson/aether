  },
  "schedules": [
    {
      "name": "morning_fly",
      "cron": "0 7 * * 1-5",
      "satellite": "wind-predictor",
      "command": "fly",
      "args": { "station": "FPS" },
      "recipients": ["+15555550102"]
    }
  ]
}
